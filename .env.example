# Unified Multi-LLM Provider & Fallback Configuration
# auto resolves configured providers in priority order:
#   gemini -> dashscope -> openai -> anthropic -> openai_compatible
LLM_PROVIDER=auto
# Optional explicit comma-separated chains (overrides LLM_PROVIDER=auto):
# LLM_PROVIDERS=gemini,dashscope,openai,anthropic
# LLM_FALLBACK_PROVIDERS=dashscope
# EMBEDDING_PROVIDERS=gemini,dashscope,openai
LLM_FALLBACK_ENABLED=true
LLM_COOLDOWN_SECONDS=60
LLM_TIMEOUT_SECONDS=120

# DashScope / Qwen (AP-Southeast-1 or international OpenAI-compatible endpoint; default fallback or standalone)
DASHSCOPE_AP_SOUTHEAST_1_API_KEY=
DASHSCOPE_AP_SOUTHEAST_1_API_URL=
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding

# Google Gemini (default primary or standalone)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional OpenAI
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Anthropic (chat / structured extraction / agent tools; embeddings skip to embedding-capable providers)
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional Generic OpenAI-Compatible Endpoint (vLLM, OpenRouter, LiteLLM, etc.)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_API_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_EMBEDDING_MODEL=

EMBEDDING_DIM=768
ONTOLOGY_DB=ontology.db
ONTOLOGY_DATA_DIR=data
ONTOLOGY_REGISTRY=ontology_registry.json
# APP_LANGUAGE=en  # Supported: en, zh, ko, ja, es, fr
